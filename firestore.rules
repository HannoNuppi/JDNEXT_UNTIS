rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Der Stundenplan darf ohne Account gelesen werden.
    match /homework/{hwKey} {
      allow read: if true;
      allow create, update, delete: if false;

      // Neue Hausaufgaben werden als einzelne, unveränderliche Dokumente gespeichert.
      // JDNEXT verwendet dafür eine anonyme Firebase-UID; ein TobiServices-Account
      // ist dafür nicht erforderlich.
      match /entries/{entryId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly([
            'text',
            'author',
            'authorUid',
            'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 3
          && request.resource.data.text.size() <= 1000
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.createdAt == request.time;

        // Nachträgliche Manipulation wird verhindert.
        allow update, delete: if false;

        // Eine anonyme/angemeldete Firebase-Identität darf denselben Eintrag
        // höchstens einmal melden. Reports selbst sind nicht öffentlich lesbar.
        match /reports/{reportUid} {
          allow read: if false;

          allow create: if request.auth != null
            && reportUid == request.auth.uid
            && exists(
              /databases/$(database)/documents/homework/$(hwKey)/entries/$(entryId)
            )
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;

          allow update, delete: if false;
        }
      }
    }

    // Alles andere bleibt standardmäßig geschlossen.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
