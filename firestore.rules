rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Die Stundenplan-Hausaufgaben sind öffentlich lesbar.
    match /homework/{hwKey} {
      allow read: if true;
      allow create, update, delete: if false;

      // Neue Hausaufgaben dürfen ohne TobiServices-Account gepostet werden.
      // Das Dokument ist nach dem Anlegen unveränderlich.
      match /entries/{entryId} {
        allow read: if true;

        allow create: if
          request.resource.data.keys().hasOnly([
            'text',
            'author',
            'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 3
          && request.resource.data.text.size() <= 1000
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;

        // Reports brauchen nur eine anonyme Firebase-Identität im Hintergrund.
        match /reports/{reportUid} {
          allow read: if false;

          allow create: if request.auth != null
            && reportUid == request.auth.uid
            && exists(
              /databases/$(database)/documents/homework/$(hwKey)/entries/$(entryId)
            )
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;

          allow update, delete: if false;
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}