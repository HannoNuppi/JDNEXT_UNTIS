rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Die Stundenplan-Hausaufgaben sind öffentlich lesbar.
    match /homework/{hwKey} {
      allow read: if true;
      allow create, update, delete: if false;

      // Neue Hausaufgaben dürfen ohne TobiServices-Account gepostet werden.
      // Das Dokument ist nach dem Anlegen unveränderlich.
      match /entries/{entryId} {
        allow read: if true;

        allow create: if
          request.resource.data.keys().hasOnly([
            'text',
            'author',
            'images',
            'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 3
          && request.resource.data.text.size() <= 1000
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 3
          && request.resource.data.images.all(image =>
            image is map
            && image.keys().hasOnly(['messageId','attachmentId','filename'])
            && image.messageId is string
            && image.messageId.size() >= 5
            && image.messageId.size() <= 30
            && image.attachmentId is string
            && image.attachmentId.size() >= 5
            && image.attachmentId.size() <= 30
            && image.filename is string
            && image.filename.size() <= 120
          )
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;

        // Reports brauchen nur eine anonyme Firebase-Identität im Hintergrund.
        match /reports/{reportUid} {
          allow read: if false;

          allow create: if request.auth != null
            && reportUid == request.auth.uid
            && exists(
              /databases/$(database)/documents/homework/$(hwKey)/entries/$(entryId)
            )
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;

          allow update, delete: if false;
        }
      }
    }

    // Klassenarbeiten: öffentlich lesbar, neue Einträge nur mit anonymer JDNEXT-Identität.
    match /classwork/{key} {
      allow read: if true;
      allow create, update, delete: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['title','createdBy','createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 120
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}