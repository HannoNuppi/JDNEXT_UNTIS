rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Die Stundenplan-Hausaufgaben sind öffentlich lesbar.
    match /homework/{hwKey} {
      allow read: if true;
      allow create, update, delete: if false;

      // Neue Hausaufgaben dürfen ohne TobiServices-Account gepostet werden.
      // Das Dokument ist nach dem Anlegen unveränderlich.
      match /entries/{entryId} {
        allow read: if true;

        allow create: if
          request.resource.data.keys().hasOnly([
            'text',
            'author',
            'images',
            'createdAt'
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() >= 3
          && request.resource.data.text.size() <= 1000
          && request.resource.data.author is string
          && request.resource.data.author.size() <= 80
          && request.resource.data.images is list
          && request.resource.data.images.size() <= 3
          && (
            request.resource.data.images.size() == 0
            || (
              request.resource.data.images[0] is map
              && request.resource.data.images[0].keys().hasOnly(['messageId','attachmentId','filename'])
              && request.resource.data.images[0].messageId is string
              && request.resource.data.images[0].attachmentId is string
              && request.resource.data.images[0].filename is string
              && request.resource.data.images[0].messageId.size() >= 15
              && request.resource.data.images[0].messageId.size() <= 25
              && request.resource.data.images[0].attachmentId.size() >= 15
              && request.resource.data.images[0].attachmentId.size() <= 25
              && request.resource.data.images[0].filename.size() <= 120
            )
          )
          && (
            request.resource.data.images.size() < 2
            || (
              request.resource.data.images[1] is map
              && request.resource.data.images[1].keys().hasOnly(['messageId','attachmentId','filename'])
              && request.resource.data.images[1].messageId is string
              && request.resource.data.images[1].attachmentId is string
              && request.resource.data.images[1].filename is string
              && request.resource.data.images[1].messageId.size() >= 15
              && request.resource.data.images[1].messageId.size() <= 25
              && request.resource.data.images[1].attachmentId.size() >= 15
              && request.resource.data.images[1].attachmentId.size() <= 25
              && request.resource.data.images[1].filename.size() <= 120
            )
          )
          && (
            request.resource.data.images.size() < 3
            || (
              request.resource.data.images[2] is map
              && request.resource.data.images[2].keys().hasOnly(['messageId','attachmentId','filename'])
              && request.resource.data.images[2].messageId is string
              && request.resource.data.images[2].attachmentId is string
              && request.resource.data.images[2].filename is string
              && request.resource.data.images[2].messageId.size() >= 15
              && request.resource.data.images[2].messageId.size() <= 25
              && request.resource.data.images[2].attachmentId.size() >= 15
              && request.resource.data.images[2].attachmentId.size() <= 25
              && request.resource.data.images[2].filename.size() <= 120
            )
          )
          && request.resource.data.createdAt == request.time;

        allow update, delete: if false;

        // Reports brauchen nur eine anonyme Firebase-Identität im Hintergrund.
        match /reports/{reportUid} {
          allow read: if false;

          allow create: if request.auth != null
            && reportUid == request.auth.uid
            && exists(
              /databases/$(database)/documents/homework/$(hwKey)/entries/$(entryId)
            )
            && request.resource.data.keys().hasOnly(['createdAt'])
            && request.resource.data.createdAt == request.time;

          allow update, delete: if false;
        }
      }
    }

    // Klassenarbeiten: öffentlich lesbar, neue Einträge nur mit anonymer JDNEXT-Identität.
    match /classwork/{key} {
      allow read: if true;
      allow create, update, delete: if false;

      match /entries/{entryId} {
        allow read: if true;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['title','createdBy','createdAt'])
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 2
          && request.resource.data.title.size() <= 120
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}