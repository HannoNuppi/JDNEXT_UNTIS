# In der VM als Administrator ausführen!

Write-Host "=== TUXLER NACH INTERNETAUSFALL REPARIEREN ===" -ForegroundColor Cyan

# 1. Hängende Tuxler-Prozesse beenden
Stop-Process -Name "*tuxler*" -Force -ErrorAction SilentlyContinue

# 2. Defekte Sitzungsdateien aus dem Ausfall löschen
Remove-Item -Path "$env:APPDATA\Tuxler" -Recurse -Force -ErrorAction SilentlyContinue
Remove-Item -Path "$env:LOCALAPPDATA\Tuxler" -Recurse -Force -ErrorAction SilentlyContinue

# 3. DNS-Cache nach dem Ausfall leeren
ipconfig /flushdns | Out-Null

# 4. Tuxler-Hintergrunddienst neu starten
Restart-Service -Name "TuxlerService" -ErrorAction SilentlyContinue
Start-Service -Name "TuxlerService" -ErrorAction SilentlyContinue

Write-Host "`nBereinigung abgeschlossen!" -ForegroundColor Green
