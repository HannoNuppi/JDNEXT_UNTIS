# In der VM als Administrator ausführen!

Write-Host "=== TUXLER CACHE & SERVICE RESET ===" -ForegroundColor Cyan

# 1. Blockierte Prozesse & Dienst stoppen
Stop-Process -Name "*tuxler*" -Force -ErrorAction SilentlyContinue
Stop-Service -Name "TuxlerService" -ErrorAction SilentlyContinue

# 2. Defekten Sitzungs-Cache löschen (Löst die "Lost Connection"-Schleife)
$appData = "$env:APPDATA\Tuxler"
$localAppData = "$env:LOCALAPPDATA\Tuxler"

if (Test-Path $appData) { 
    Remove-Item -Path $appData -Recurse -Force -ErrorAction SilentlyContinue 
}
if (Test-Path $localAppData) { 
    Remove-Item -Path $localAppData -Recurse -Force -ErrorAction SilentlyContinue 
}

# 3. Netzwerkverbindungen & DNS leeren
netsh winsock reset | Out-Null
ipconfig /flushdns | Out-Null

# 4. Tuxler-Dienst neu starten
Set-Service -Name "TuxlerService" -StartupType Automatic -ErrorAction SilentlyContinue
Start-Service -Name "TuxlerService" -ErrorAction SilentlyContinue

Write-Host "`nReset erfolgreich! Starte Tuxler jetzt neu." -ForegroundColor Green
