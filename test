# In der VM als Administrator ausführen!

Write-Host "=== SCHRITT 1: SURFSHARK-RESTESÄUBERUNG & NETZWERK-RESET ===" -ForegroundColor Cyan

# 1. Windows Proxy-Einstellungen komplett zurücksetzen
netsh winhttp reset proxy
Set-ItemProperty -Path 'HKCU:\Software\Microsoft\Windows\CurrentVersion\Internet Settings' -Name ProxyEnable -Value 0 -ErrorAction SilentlyContinue

# 2. DNS-Einstellungen aller Netzwerkadapter auf Automatisch (DHCP) zurücksetzen
Get-NetAdapter | Where-Object Status -eq "Up" | Set-DnsClientServerAddress -ResetServerAddresses -ErrorAction SilentlyContinue

# 3. Winsock, IP-Stack und DNS-Cache leeren
netsh winsock reset | Out-Null
netsh int ip reset | Out-Null
ipconfig /flushdns | Out-Null

Write-Host "`n=== SCHRITT 2: TUXLER-DIENST REPARIEREN ===" -ForegroundColor Cyan

# 4. Blockierte Tuxler-Hintergrundprozesse beenden
Stop-Process -Name "*tuxler*" -Force -ErrorAction SilentlyContinue

# 5. Tuxler-Dienst auf 'Automatisch' stellen und neu starten (wichtig für die Erweiterung!)
Set-Service -Name "TuxlerService" -StartupType Automatic -ErrorAction SilentlyContinue
Restart-Service -Name "TuxlerService" -ErrorAction SilentlyContinue
Start-Service -Name "TuxlerService" -ErrorAction SilentlyContinue

Write-Host "`n==========================================" -ForegroundColor Green
Write-Host " SÄUBERUNG ABGESCHLOSSEN! Bitte VM neu starten. " -ForegroundColor Green
Write-Host "==========================================" -ForegroundColor Green
